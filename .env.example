BROWSER_START_URL=https://www.weee.com/en/cart
BROWSER_CART_URL=https://www.weee.com/en/cart
# local=本机 Playwright；bitbrowser=连接比特浏览器指纹窗口
BROWSER_PROVIDER=local
# cart=回到购物车，prepare=打开支付表单后停止，payment=填写并保存支付方式
BROWSER_CHECKOUT_URL=https://www.weee.com/en/order/checkout?cart_domain=grocery
BROWSER_CHECKOUT_MODE=prepare
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=30000
BROWSER_DATA_FILE=
BROWSER_REPEAT=1
# 需要复用登录状态时再填写路径；留空可避免旧会话干扰新邮箱登录
BROWSER_STORAGE_STATE=
BROWSER_CONTINUE_ON_ERROR=false
WORKFLOW_PAYLOAD_FILE=workflow.js.enc
# 可选：设置后不提示输入独立的运行授权密码
APP_RUN_PASSWORD=
# 可选：设置后不提示输入 workflow.js.enc 的流程解密密码。
# 该密码就是本地生成 workflow.js.enc 时使用的 CLIENT_PAYLOAD_PASSWORD。
APP_PAYLOAD_PASSWORD=
BROWSER_CODE_TIMEOUT_MS=120000
BROWSER_MAIL_POLL_MS=5000
BROWSER_USE_BUNDLED=true
BROWSER_PARALLEL=true
# 如需指定浏览器，可填写完整可执行文件路径
# BROWSER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# 比特浏览器 Local Server 配置。也可以改用 bitbrowser.config.json
BITBROWSER_CONFIG_FILE=bitbrowser.config.json
BITBROWSER_API_URL=http://127.0.0.1:54345
BITBROWSER_BROWSER_IDS=
BITBROWSER_QUEUE=true
BITBROWSER_CLOSE_ON_EXIT=false
BITBROWSER_API_TIMEOUT_MS=15000
# 可选：启动窗口前自动设置代理；支持 socks5h://user:password@host:port
BITBROWSER_PROXY_URL=

# vfutai 虚拟邮箱 API 配置。令牌只放在本机 .env，不要提交到版本库
TEMP_MAIL_TOKEN=
TEMP_MAIL_SEED=aahd
TEMP_MAIL_DOMAIN=drime.space
TEMP_MAIL_API_URL=https://mb-d.vfutai.com/y/
TEMP_MAIL_API_TIMEOUT_MS=15000
# 多窗口同时收验证码时，receive 请求之间的最小间隔（毫秒）
TEMP_MAIL_MIN_REQUEST_INTERVAL_MS=250

# payment 模式默认逐行读取同级目录 cards.txt；保存成功的原始行写入 saved-cards.txt
PAYMENT_CARD_FILE=cards.txt
PAYMENT_SAVED_FILE=saved-cards.txt
PAYMENT_MAX_SAVES_PER_MAILBOX=3
PAYMENT_MAX_RATE_LIMIT_RESTARTS=20
# 如果 cards.txt 不存在，才回退到下面这组单卡配置
PAYMENT_CARD_NUMBER=
PAYMENT_EXPIRATION_DATE=
PAYMENT_CVV=
PAYMENT_POSTAL_CODE=
